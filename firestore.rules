rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation
    function isValidFlashcard(data) {
      return data.keys().hasAll(['userId', 'concept', 'originalText', 'simplifiedText', 'analogy', 'createdAt'])
        && data.keys().size() == 6
        && data.userId is string
        && data.concept is string && data.concept.size() <= 500
        && data.originalText is string && data.originalText.size() <= 5000
        && data.simplifiedText is string && data.simplifiedText.size() <= 5000
        && data.analogy is string && data.analogy.size() <= 10000
        && data.createdAt == request.time;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['userId', 'originalText', 'simplifiedText', 'createdAt'])
        && data.keys().size() == 4
        && data.userId is string
        && data.originalText is string && data.originalText.size() <= 5000
        && data.simplifiedText is string && data.simplifiedText.size() <= 5000
        && data.createdAt == request.time;
    }

    match /flashcards/{cardId} {
      allow create: if isSignedIn() 
        && isOwner(request.resource.data.userId)
        && isValidFlashcard(request.resource.data);
      
      allow read, delete: if isOwner(resource.data.userId);
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /history/{historyId} {
      allow create: if isSignedIn()
        && isOwner(request.resource.data.userId)
        && isValidHistory(request.resource.data);
      
      allow read: if isOwner(resource.data.userId);
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
